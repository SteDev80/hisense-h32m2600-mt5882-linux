#!/bin/sh

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

/bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
/bin/mount -t proc proc /proc 2>/dev/null || true
/bin/mount -t sysfs sysfs /sys 2>/dev/null || true
/bin/mount -t tmpfs tmpfs /tmp 2>/dev/null || true

echo
echo "============================================================"
echo " MT5882 RAM-only Linux test"
echo " No eMMC partition has been mounted or modified."
echo " Type: uname -a ; cat /proc/cpuinfo ; cat /proc/meminfo"
echo " Power-cycle the TV to return to the original firmware."
echo "============================================================"
echo

exec /bin/sh </dev/console >/dev/console 2>&1
