#!/bin/sh
set -eu
export LD_LIBRARY_PATH=/opt/h32-audio/lib
export ALSA_CONFIG_DIR=/opt/h32-audio/share/alsa
export ALSA_CONFIG_PATH=/opt/h32-audio/asound.conf
export SDL_AUDIODRIVER=alsa
export SDL_AUDIO_ALSA_DEFAULT_DEVICE=default
export SDL_RENDER_DRIVER=software
export DISPLAY=${DISPLAY:-:0}
if ! grep -q mtk /proc/asound/cards; then
    echo 'Audio TV non disponibile. Controllare /var/log/h32-audio.log.' >&2
    exit 1
fi
volume_file=/mnt/usb2/archlinux/rootfs/root/.config/h32-volume
volume=10
if [ -r "$volume_file" ]; then
    candidate=$(sed -n '1p' "$volume_file")
    case "$candidate" in
        ''|*[!0-9]*) ;;
        *) [ "$candidate" -le 100 ] && volume=$candidate ;;
    esac
fi
last=''
for argument in "$@"; do last=$argument; done
case "${last##*.}" in
    mp3|MP3|m4a|M4A|aac|AAC|wav|WAV|flac|FLAC|ogg|OGG)
        chroot /mnt/usb2/archlinux/rootfs /usr/bin/env DISPLAY="$DISPLAY" \
            /usr/bin/python3 /usr/local/bin/h32-visualizer-click.py >/dev/null 2>&1 &
        click_pid=$!
        /usr/bin/ffplay -nostats -loglevel warning -autoexit -showmode 2 \
            -volume "$volume" -x 800 -y 450 "$@"
        result=$?
        kill "$click_pid" 2>/dev/null || true
        exit "$result"
        ;;
    *) exec /usr/bin/ffplay -nostats -loglevel warning -autoexit -volume "$volume" -x 800 -y 450 "$@" ;;
esac
